{
  "$schema": "https://opencode.ai/config.json",
  "snapshot": true,
  "small_model": "anthropic/claude-haiku-4-5",
  "compaction": {
    "tail_turns": 15
  },
  "plugin": [
    ".opencode/safety-guard.ts"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "ask",
      "git *": "allow",
      "qmd *": "allow",
      "mise *": "allow",
      "node .opencode/scripts/*": "allow",
      "node .claude/scripts/*": "allow",
      "rm -rf *": "deny",
      "sudo *": "deny"
    },
    "external_directory": {
      "*": "ask",
      "~/workspace/**": "allow"
    }
  }
}
